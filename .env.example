# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API).
# Both of these ship to the browser, which is why only the ANON key belongs here:
# it is safe by design because row-level security restricts every table to its owner.
# The service_role key bypasses RLS entirely and must never be used in this project.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
